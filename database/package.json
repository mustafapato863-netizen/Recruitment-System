{
  "name": "@recruitflow/database",
  "private": true,
  "version": "0.1.0",
  "main": "generated/client/index.js",
  "types": "generated/client/index.d.ts",
  "exports": {
    ".": {
      "types": "./generated/client/index.d.ts",
      "require": "./generated/client/index.js",
      "default": "./generated/client/index.js"
    }
  },
  "scripts": {
    "prisma:generate": "node scripts/prisma.cjs generate --schema prisma/schema.prisma",
    "prisma:format": "node scripts/prisma.cjs format --schema prisma/schema.prisma",
    "prisma:validate": "node scripts/prisma.cjs validate --schema prisma/schema.prisma",
    "prisma:migrate:deploy": "node scripts/prisma.cjs migrate deploy --schema prisma/schema.prisma",
    "prisma:migrate:status": "node scripts/prisma.cjs migrate status --schema prisma/schema.prisma",
    "prisma:seed": "node prisma/seed.cjs"
  },
  "dependencies": {
    "@prisma/client": "6.19.3",
    "dotenv": "16.6.1"
  },
  "devDependencies": {
    "prisma": "6.19.3"
  }
}
