{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "module": "commonjs",
    "moduleResolution": "Node",
    "verbatimModuleSyntax": false,
    "declaration": true,
    "removeComments": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "allowSyntheticDefaultImports": true,
    "sourceMap": true,
    "outDir": "./dist",
    "baseUrl": "./",
    "paths": {
      "@recruitflow/contracts": ["../../packages/contracts/src/index.ts"],
      "@recruitflow/database": ["../../database/generated/client/index.d.ts"]
    },
    "incremental": true,
    "skipLibCheck": true
  },
  "include": ["src/**/*.ts"]
}
