{
  "name": "recruitflow",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@11.9.0",
  "scripts": {
    "dev:web": "pnpm --dir apps/web dev",
    "dev:api": "pnpm --dir apps/api start:dev",
    "dev:worker": "pnpm --dir apps/worker dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint apps packages --max-warnings=0",
    "lint:web": "eslint apps/web --max-warnings=0",
    "db:generate": "pnpm --dir database prisma:generate",
    "db:format": "pnpm --dir database prisma:format",
    "db:validate": "pnpm --dir database prisma:validate"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.8.0",
    "globals": "^17.7.0",
    "typescript-eslint": "^8.65.0"
  }
}
