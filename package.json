{
  "name": "recruitflow",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@11.9.0",
  "scripts": {
    "dev:web": "pnpm --dir apps/web dev",
    "dev:api": "pnpm --dir apps/api start:dev",
    "dev:worker": "pnpm --dir apps/worker dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint apps/api apps/worker packages --max-warnings=0",
    "lint:web": "pnpm --dir apps/web lint",
    "db:generate": "prisma generate --schema database/prisma/schema.prisma",
    "db:format": "prisma format --schema database/prisma/schema.prisma",
    "db:validate": "prisma validate --schema database/prisma/schema.prisma"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.8.0",
    "globals": "^17.7.0",
    "typescript-eslint": "^8.65.0",
    "prisma": "^6.15.0"
  }
}
