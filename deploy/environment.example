# Copy to untracked .env.production for compose; use runtime settings in Dokploy.
NODE_ENV=production
PORT=3000
VACANCY_CORE_ADAPTER=prisma
DATABASE_URL=postgresql://USER:PASSWORD@DATABASE_HOST:5432/recruitflow?schema=public
WEB_ORIGIN=https://YOUR_RECRUITFLOW_DOMAIN
APP_WEB_URL=https://YOUR_RECRUITFLOW_DOMAIN
# Hostinger same-origin web/API: lax. Vercel frontend calling a separate API:
# set this to none and configure WEB_ORIGIN to the exact Vercel HTTPS origin.
AUTH_COOKIE_SAME_SITE=lax
# Number of trusted proxy hops. Adjust to your actual private proxy topology.
TRUST_PROXY=1
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
SELF_SCHEDULE_SECRET=
# Exactly 64 random hexadecimal characters, identical in API and worker.
EMAIL_OUTBOX_ENCRYPTION_KEY=
RECRUITFLOW_DOCUMENT_STORAGE_PATH=/data/documents
RECRUITFLOW_DOCUMENT_STORAGE_PROVIDER=local-private
RECRUITFLOW_DOCUMENT_BACKUP_PROVIDER=not-configured
# Set false while email delivery is frozen. Use true with real SMTP settings to enable it.
MAIL_DELIVERY_ENABLED=false
MAIL_TRANSPORT=console
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
# Optional: without Redis the worker uses the persisted database polling queue.
REDIS_URL=
