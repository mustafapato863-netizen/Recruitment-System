NODE_ENV=development
API_PORT=3000
WEB_ORIGIN=http://localhost:5173

# Local PostgreSQL connection. Keep real credentials in an untracked .env file.
DATABASE_URL=postgresql://postgres:CHANGE_ME@localhost:5432/Recruitment_DB?schema=public
VACANCY_CORE_ADAPTER=in-memory

REDIS_URL=redis://localhost:6379
SESSION_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_VALUE

OBJECT_STORAGE_ENDPOINT=http://localhost:9000
OBJECT_STORAGE_REGION=us-east-1
OBJECT_STORAGE_BUCKET=recruitflow-private
OBJECT_STORAGE_ACCESS_KEY=CHANGE_ME
OBJECT_STORAGE_SECRET_KEY=CHANGE_ME
