NODE_ENV=development
API_PORT=3000
# Comma-separated list is supported for approved web origins.
WEB_ORIGIN=http://localhost:5173

# Local PostgreSQL connection. Keep real credentials in an untracked .env file.
DATABASE_URL=postgresql://postgres:CHANGE_ME@localhost:5432/Recruitment_DB?schema=public
VACANCY_CORE_ADAPTER=prisma

REDIS_URL=redis://localhost:6379
SESSION_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_VALUE
JWT_ACCESS_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_VALUE
JWT_REFRESH_SECRET=CHANGE_ME_TO_A_DIFFERENT_LONG_RANDOM_VALUE
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
# HMAC signing key for public candidate self-scheduling links (min 32 chars).
SELF_SCHEDULE_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_VALUE

# Authentication rate limiting and lockout configuration
AUTH_MAX_ATTEMPTS=5
AUTH_IP_MAX_ATTEMPTS=25
AUTH_LOCKOUT_DURATION=900
AUTH_WINDOW_DURATION=300

OBJECT_STORAGE_ENDPOINT=http://localhost:9000
OBJECT_STORAGE_REGION=us-east-1
OBJECT_STORAGE_BUCKET=recruitflow-private
OBJECT_STORAGE_ACCESS_KEY=CHANGE_ME
OBJECT_STORAGE_SECRET_KEY=CHANGE_ME

# Local development fallback for private CV storage. Production should map this
# to a private persistent volume or replace it with the approved object-storage adapter.
RECRUITFLOW_DOCUMENT_STORAGE_PATH=./storage/documents
RECRUITFLOW_DOCUMENT_STORAGE_PROVIDER=local-private
# Leave unset until a tested binary backup provider is configured. The current
# Excel export is a metadata manifest and does not contain CV binaries.
RECRUITFLOW_DOCUMENT_BACKUP_PROVIDER=not-configured
# Set this only from an external backup job after a verified successful snapshot.
RECRUITFLOW_DOCUMENT_BACKUP_LAST_SUCCESS_AT=

# ── Async email delivery (Phase 1) ─────────────────────────────
# Worker transport: console (dev sink, logs rendered emails) or smtp.
MAIL_TRANSPORT=console
# AES-256-GCM key for auth tokens in the email outbox. Required in production.
# Use 64 hex characters (for example: openssl rand -hex 32).
EMAIL_OUTBOX_ENCRYPTION_KEY=
# SMTP settings — required only when MAIL_TRANSPORT=smtp
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=no-reply@recruitflow.local
# Web app base URL used in email action links
APP_WEB_URL=http://localhost:5173
# Outbox drain loop tuning
WORKER_BATCH_SIZE=20
WORKER_POLL_INTERVAL_MS=2000
# Processing lease used to reclaim rows after a worker crash.
WORKER_PROCESSING_LEASE_MS=300000
